{
  "name": "facturas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "dev:electron": "concurrently -k \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --dir",
    "skillspector": ".venv312\\Scripts\\skillspector",
    "scan:skills": ".venv312\\Scripts\\skillspector scan --no-llm --recursive .agents/skills"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.55.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.eleco.facturas",
    "productName": "Gestor de Facturas de El Eco",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/sql-wasm.wasm",
      "**/pdf.worker.min.mjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gestor de Facturas de El Eco"
    }
  }
}
